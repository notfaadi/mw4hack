---
import { t } from '../i18n';
import { ROUTES } from '../utils/path';
import { homeHeroSlides } from '../data/heroBanner';
import { heroMarqueePills, heroStatIcons } from '../data/sectionIcons';
import ImageSlider from './ImageSlider.astro';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { Badge } from '@/components/starwind/badge';

const h = t.hero;

---

<section
  id="hero"
  class="relative overflow-hidden border-b border-border"
  aria-labelledby="hero-title"
>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,var(--primary)_0%,transparent_55%)] opacity-20" aria-hidden="true" />

  <div class="relative mx-auto flex max-w-6xl flex-col justify-center px-5">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="w-full max-w-xl space-y-4 text-left md:space-y-5 lg:max-w-md">
        <Badge variant="secondary" class="border-border/80 bg-neutral-900/80 px-2.5 py-0.5 text-[11px] uppercase tracking-[0.12em] text-neutral-100">
          {h.eyebrow}
        </Badge>

        <h1
          id="hero-title"
          class="max-w-[16rem] font-[family-name:var(--font-heading)] text-[1.625rem] font-extrabold uppercase leading-[1.15] tracking-wide text-foreground sm:max-w-none sm:text-[1.875rem] md:text-[2.25rem] md:leading-[1.1] lg:text-[2.5rem]"
        >
          {h.titleLine1}
          {h.titleLine2 ? <span class="block">{h.titleLine2}</span> : null}
        </h1>

        <p class="max-w-md text-sm leading-relaxed text-neutral-400 md:text-base md:leading-7">
          {h.subtitle}
        </p>

        <div class="flex flex-wrap justify-start gap-3 sm:gap-4">
          <Button
            as="a"
            href={ROUTES.products}
            data-scroll-target="products"
            variant="secondary"
            size="lg"
            class="rounded-full border-0 bg-white px-6 text-neutral-950 shadow-md hover:bg-neutral-100 dark:bg-white dark:text-neutral-950 dark:hover:bg-neutral-200"
          >
            {h.ctaPrimary}
            <Icon name="arrowRight" size={18} />
          </Button>
          <Button
            as="a"
            href={ROUTES.products}
            data-scroll-target="products"
            variant="outline"
            size="lg"
            class="rounded-full border-border/80 bg-transparent px-6 text-foreground hover:border-primary/50 hover:bg-primary/10"
          >
            {h.ctaCloudDma}
            <Icon name="arrowRight" size={18} />
          </Button>
        </div>
      </div>

      <div class="mx-auto flex w-full max-w-xl flex-col items-stretch gap-5 lg:mx-0 lg:max-w-none">
        <ImageSlider images={homeHeroSlides} id="hero-slider" variant="hero" />
        <div class="grid w-full grid-cols-2 gap-2.5 sm:gap-3 md:grid-cols-4 lg:grid-cols-2">
          {h.metrics.map((m, i) => (
            <div class="flex min-w-0 items-center gap-3 rounded-xl border border-border/80 bg-card/70 px-3 py-3 shadow-sm shadow-black/10 transition-colors hover:border-primary/40">
              <span
                class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/15 ring-1 ring-inset ring-primary/25"
                aria-hidden="true"
              >
                <Icon name={heroStatIcons[i] ?? 'check'} size={18} />
              </span>
              <div class="min-w-0">
                <p class="font-[family-name:var(--font-heading)] text-base font-bold leading-none tracking-tight text-foreground">{m.strong}</p>
                <p class="mt-1 text-xs leading-tight text-muted-foreground">{m.label}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div
    class="hero-status-marquee relative mt-8 border-t border-border/70 py-3 md:mt-10 md:py-4 lg:mt-12"
    aria-label="Features and platform support"
  >
    <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-background to-transparent md:w-24" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-background to-transparent md:w-24" aria-hidden="true" />
    <div class="hero-status-marquee-track flex w-max items-center gap-2 md:gap-2.5">
      {[...heroMarqueePills, ...heroMarqueePills].map((pill) => (
        <span class="hero-marquee-pill inline-flex shrink-0 items-center whitespace-nowrap">
          <Icon name={pill.icon} size={14} class="hero-marquee-pill__icon shrink-0" aria-hidden="true" />
          {pill.label}
        </span>
      ))}
    </div>
  </div>
</section>
