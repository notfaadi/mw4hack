---
import { mw4HowToUse } from '../../data/mw4HowToUse';
import Icon from '../icons/Icon.astro';
import {
  Accordion,
  AccordionContent,
  AccordionItem,
  AccordionTrigger,
} from '@/components/starwind/accordion';

const guide = mw4HowToUse;
---

<section class="product-how-to-use pb-16 pt-2 md:pb-24 md:pt-4" aria-labelledby="product-how-to-use-trigger">
  <div class="mx-auto max-w-6xl px-5">
    <Accordion type="single" collapsible class="product-how-to-use__accordion w-full" data-how-to-accordion>
      <AccordionItem value="how-to-use-mw4" class="product-how-to-use__item border-0">
        <AccordionTrigger
          id="product-how-to-use-trigger"
          class="product-how-to-use__trigger rounded-2xl border border-primary/25 bg-card px-4 py-3.5 shadow-sm hover:text-foreground md:px-5 md:py-4"
        >
          <span class="flex min-w-0 flex-1 items-center gap-3 md:gap-4">
            <span
              class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-border/80 bg-background/80"
              aria-hidden="true"
            >
              <Icon name="faqBlogSetup" size={20} class="text-foreground/90" />
            </span>
            <span class="product-how-to-use__label font-[family-name:var(--font-heading)] text-sm font-bold uppercase tracking-[0.14em] text-foreground md:text-[0.8125rem]">
              {guide.triggerLabel}
            </span>
          </span>
        </AccordionTrigger>
        <AccordionContent class="product-how-to-use__content px-1 pt-4 md:px-2 md:pt-5">
          <div class="rounded-2xl border border-border/80 bg-card/60 px-5 py-6 md:px-8 md:py-8">
            <h2 class="font-[family-name:var(--font-heading)] text-xl font-bold text-foreground md:text-2xl">
              {guide.gameTitle}
            </h2>
            <p class="mt-4 text-sm leading-relaxed text-muted-foreground md:text-[0.9375rem] md:leading-7">
              {guide.intro}
            </p>

            {
              guide.sections.map((section) => (
                <div class="mt-8">
                  <h3 class="font-[family-name:var(--font-heading)] text-base font-bold text-foreground md:text-lg">
                    {section.heading}
                  </h3>
                  {section.paragraphs.map((p) => (
                    <p class="mt-3 text-sm leading-relaxed text-muted-foreground md:text-[0.9375rem] md:leading-7">
                      {p}
                    </p>
                  ))}
                </div>
              ))
            }

            {
              guide.closing ? (
                <p class="mt-8 border-t border-border/70 pt-6 text-sm leading-relaxed text-muted-foreground md:text-[0.9375rem] md:leading-7">
                  {guide.closing}
                </p>
              ) : null
            }
          </div>
        </AccordionContent>
      </AccordionItem>
    </Accordion>
  </div>
</section>
