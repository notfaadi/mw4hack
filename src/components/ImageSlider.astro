---
import ResponsiveImage from './ResponsiveImage.astro';
import {
  HERO_BAR_SIZES,
  HERO_BAR_WIDTHS,
  HERO_IMAGE_SIZES,
  HERO_IMAGE_WIDTHS,
} from '../utils/responsiveImage';
import {
  Carousel,
  CarouselContent,
  CarouselItem,
  CarouselNext,
  CarouselPrevious,
} from '@/components/starwind/carousel';
import Icon from './icons/Icon.astro';

interface Slide {
  src: string;
  alt: string;
  caption: string;
  captionDesc: string;
}

interface Props {
  images: Slide[];
  id: string;
  variant?: 'default' | 'hero' | 'heroBar';
  desktopOnly?: boolean;
}

const { images, id, variant = 'default', desktopOnly = false } = Astro.props;
const isHeroBar = variant === 'heroBar';
const isHero = variant === 'hero' || isHeroBar;
const imageSizes = isHeroBar
  ? HERO_BAR_SIZES
  : isHero
    ? HERO_IMAGE_SIZES
    : '(min-width: 1024px) 640px, 100vw';
const imageWidths = isHeroBar ? HERO_BAR_WIDTHS : isHero ? HERO_IMAGE_WIDTHS : undefined;
---

<div
  class:list={[
    'relative w-full',
    isHeroBar
      ? 'bg-black'
      : isHero
        ? 'overflow-hidden rounded-xl border border-border bg-black shadow-sm'
        : 'rounded-xl border border-border bg-card p-2 shadow-sm',
    !isHero && desktopOnly && 'hidden lg:block',
  ]}
  id={id}
  data-hero-embla-wrap={isHero || undefined}
>
  <Carousel
    autoInit={false}
    data-hero-embla={isHero || undefined}
    opts={{ loop: images.length > 1, align: 'start' }}
    class:list={[
      'w-full',
      isHero &&
        '[&_[data-sw-carousel-viewport]]:overflow-hidden [&_[data-sw-carousel-container]]:!ml-0',
    ]}
  >
    <CarouselContent class:list={[isHero && '!ml-0 !mt-0']}>
      {images.map((img, i) => (
        <CarouselItem class:list={['basis-full', isHero && '!min-w-full !grow-0 !shrink-0 !basis-full !pl-0 !pt-0']}>
          <figure
            class:list={[
              isHeroBar
                ? 'aspect-[21/9] max-h-[min(52vh,520px)] min-h-[200px] w-full overflow-hidden sm:min-h-[240px] md:min-h-[280px]'
                : isHero
                  ? 'relative m-0 aspect-video w-full overflow-hidden bg-black'
                  : 'overflow-hidden rounded-lg',
            ]}
          >
            <div
              class:list={[
                isHero &&
                  'absolute inset-0 [&_img]:size-full [&_img]:object-cover [&_img]:object-center [&_picture]:block [&_picture]:size-full',
              ]}
            >
              <ResponsiveImage
                src={img.src}
                alt={img.alt}
                width={isHeroBar ? 1920 : 960}
                height={isHeroBar ? 823 : 540}
                widths={imageWidths}
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchPriority={isHero && i === 0 ? 'high' : undefined}
                sizes={imageSizes}
                desktopOnly={isHero ? false : desktopOnly}
              />
            </div>
            {!isHero && (img.caption || img.captionDesc) && (
              <figcaption class="mt-2 px-1 text-sm text-muted-foreground">
                <strong class="text-foreground">{img.caption}</strong>
                {img.captionDesc && ` — ${img.captionDesc}`}
              </figcaption>
            )}
          </figure>
        </CarouselItem>
      ))}
    </CarouselContent>
    {isHero && images.length > 1 && (
      <>
        <button
          type="button"
          data-hero-embla-prev
          class="absolute left-3 top-1/2 z-20 flex size-9 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 bg-black/55 text-white backdrop-blur-sm transition hover:bg-black/75"
          aria-label="Previous slide"
        >
          <Icon name="chevronLeft" size={20} />
        </button>
        <button
          type="button"
          data-hero-embla-next
          class="absolute right-3 top-1/2 z-20 flex size-9 -translate-y-1/2 items-center justify-center rounded-full border border-white/20 bg-black/55 text-white backdrop-blur-sm transition hover:bg-black/75"
          aria-label="Next slide"
        >
          <Icon name="chevronRight" size={20} />
        </button>
      </>
    )}
    {!isHero && images.length > 1 && (
      <>
        <CarouselPrevious class="left-2" />
        <CarouselNext class="right-2" />
      </>
    )}
  </Carousel>
  {isHero && images.length > 1 && (
    <div
      class="pointer-events-none absolute inset-x-0 bottom-3 z-20 flex justify-center"
      data-hero-embla-dots
      role="tablist"
      aria-label="Hero slides"
    >
      <div class="pointer-events-auto flex items-center gap-1.5 rounded-full border border-white/10 bg-black/45 px-2.5 py-1.5 backdrop-blur-sm">
        {images.map((_, i) => (
          <button
            type="button"
            role="tab"
            class="hero-embla-dot relative h-2 shrink-0 overflow-hidden rounded-full bg-white/30 transition-[width] duration-300 data-[active=false]:w-2 data-[active=true]:w-9"
            data-hero-embla-dot={i}
            aria-label={`Slide ${i + 1}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-active={i === 0 ? 'true' : 'false'}
          >
            <span
              class="hero-embla-progress pointer-events-none absolute inset-y-0 left-0 w-0 rounded-full bg-primary"
              data-hero-embla-progress
              aria-hidden="true"
            />
          </button>
        ))}
      </div>
    </div>
  )}
</div>
